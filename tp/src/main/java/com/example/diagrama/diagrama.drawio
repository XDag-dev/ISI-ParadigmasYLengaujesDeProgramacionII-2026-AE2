                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Imprimible {\n    &lt;&lt;interface&gt;&gt;\n    +imprimirTicket() void\n  }\n\n  class Exportable {\n    &lt;&lt;interface&gt;&gt;\n    +generarFilaTexto() String\n  }\n\n  class Persona {\n    &lt;&lt;abstract&gt;&gt;\n    -String nombre\n    #String dni\n    -String domicilio\n    -String telefono\n    -CondicionIVA condicionIVA\n    +getDetalleRol() String\n  }\n\n  class ItemFacturable {\n    &lt;&lt;abstract&gt;&gt;\n    -String codigo\n    -String nombre\n    -double precio\n    -String tipo\n    +getDescripcion() String\n  }\n\n  class Cliente {\n    -double limiteCredito\n    -String categoria\n    +agregarFactura(Factura factura) void\n  }\n\n  class Empleado {\n    -double salario\n    -String puesto\n    -LocalDate fechaIngreso\n  }\n\n  class Proveedor {\n    -String razonSocial\n    -String cuit\n  }\n\n  class Departamento {\n    -String nombre\n    -double presupuesto\n    +setResponsable(Empleado empleado) void\n    +agregarEmpleado(Empleado empleado) void\n  }\n\n  class Producto {\n    +getDescripcion() String\n  }\n\n  class Servicio {\n    +getDescripcion() String\n  }\n\n  class Factura {\n    -int puntoVenta\n    -int numeroComprobante\n    -LocalDate fechaEmision\n    -TipoComprobante tipoComprobante\n    -MetodoPago metodoPago\n    -EstadoPago estadoPago\n    -String cae\n    -LocalDate vencimientoCae\n    +calcularTotal() double\n    +procesarFactura() void\n  }\n\n  class LineaFactura {\n    -int cantidad\n    -double precioUnitario\n    -double bonificacion\n    +calcularSubtotal() double\n  }\n\n  Persona &lt;|-- Cliente\n  Persona &lt;|-- Empleado\n  Persona &lt;|-- Proveedor\n\n  ItemFacturable &lt;|-- Producto\n  ItemFacturable &lt;|-- Servicio\n\n  Imprimible &lt;|.. Factura\n  Exportable &lt;|.. Factura\n\n  Departamento \&quot;1\&quot; o-- \&quot;0..*\&quot; Empleado : agrupa miembros\n  Departamento \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Empleado : asigna responsable\n\n  Proveedor \&quot;1\&quot; o-- \&quot;0..*\&quot; ItemFacturable : suministra\n\n  Cliente \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : almacena / recibe\n  Empleado \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Factura : emite\n\n  Factura \&quot;1\&quot; *-- \&quot;1..*\&quot; LineaFactura : contiene\n  LineaFactura \&quot;0..*\&quot; --&gt; \&quot;1\&quot; ItemFacturable : referencia&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="imlTCMMuH6uUgh-HutVi-2">
